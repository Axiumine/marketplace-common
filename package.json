	"homepage": "https://github.com/Axiumine/marketplace-common#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Axiumine/marketplace-common.git"
	},
	"bugs": {
		"url": "https://github.com/Axiumine/marketplace-common/issues"
	},

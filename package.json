	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"prepare": "yarn run hooks:install && rm -rf dist && yarn run build",
		"hooks:install": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .githooks && ./scripts/lockfile-registry-filter.sh install || true",
		"build": "yarn run build:esm",
		"prepare:all": "echo 'read REAMDE' && rm -rf dist && yarn run build:all",
		"build:all": "yarn run build:cjs && yarn run build:esm",
		"build:cjs": "yarn run tsc -p tsconfig.cjs.json && find dist/cjs -type f -name \"*.js\" -exec bash -c 'mv \"$0\" \"${0%.js}.cjs\"' {} \\; && cp -R dist/cjs/* dist/ && rm -rf dist/cjs",
		"build:esm": "yarn run tspc -p tsconfig.json",
		"lint": "eslint --fix . && prettier --write .",
		"lint:check": "eslint . && prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cov": "vitest run --coverage",
		"test:contract": "yarn build && vitest run -c vitest.contract.config.mts",
		"test:int": "vitest run -c vitest.integration.config.mts",
		"test:types": "vitest run -c vitest.types.config.mts",
		"test:mutation": "stryker run",
		"test:all": "yarn test:cov && yarn test:contract && yarn test:int && yarn test:types",
		"upload": "npm publish --registry=https://registry.npmjs.org/",
		"update": "yarn upgrade-interactive --latest --network-timeout 100000",
		"cloc": "cloc . --exclude-dir=node_modules,dist,.git,upload",
		"scc": "scc . --exclude-dir=node_modules,dist,.git -w --sort --directory-walker-job-workers=32 --count-as=mts:TypeScript",
		"semgrep": "docker run --rm --network none -e HOME=/tmp -u \"$(id -u):$(id -g)\" -v \"$PWD\":/src -w /src semgrep/semgrep:1.172.0 semgrep scan --metrics=off --disable-version-check --scan-unknown-extensions --config semgrep/ $(find src -type f \\( -name '*.mts' -o -name '*.cts' -o -name '*.ts' -o -name '*.mjs' -o -name '*.cjs' -o -name '*.js' \\))",
		"semgrep:ci": "docker run --rm --network none -e HOME=/tmp -u \"$(id -u):$(id -g)\" -v \"$PWD\":/src -w /src semgrep/semgrep:1.172.0 semgrep scan --metrics=off --disable-version-check --scan-unknown-extensions --error --sarif --output semgrep.sarif --config semgrep/ $(find src -type f \\( -name '*.mts' -o -name '*.cts' -o -name '*.ts' -o -name '*.mjs' -o -name '*.cjs' -o -name '*.js' \\))",
		"qodana": "./qodana.sh"
	},
	"engines": {
		"node": "^24.18.0"
	},
